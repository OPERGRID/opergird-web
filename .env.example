# Public Supabase configuration.
# These values may be used by browser-side Supabase clients.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# IMPORTANT:
# Never expose SUPABASE_SERVICE_ROLE_KEY or other privileged
# secrets to browser/client code.
OPERGRID_CAPTCHA_SECRET=replace-with-a-long-random-server-only-secret
